From: Frish2021 <1573880184@qq.com>
Date: Mon, 25 Aug 2025 17:46:33 +0800
Subject: [PATCH] Setup new Scheduler and added disable `folia-supported`
 field.


diff --git a/src/main/java/io/papermc/paper/plugin/provider/configuration/PaperPluginMeta.java b/src/main/java/io/papermc/paper/plugin/provider/configuration/PaperPluginMeta.java
index fb7c6621e2805f4339c255f6c2e02c55ff4c502e..43151a541cb5a539cc5c178f8c4589610ef68a13 100644
--- a/src/main/java/io/papermc/paper/plugin/provider/configuration/PaperPluginMeta.java
+++ b/src/main/java/io/papermc/paper/plugin/provider/configuration/PaperPluginMeta.java
@@ -255,6 +255,9 @@ public class PaperPluginMeta implements PluginMeta {
     // Folia start
     @Override
     public boolean isFoliaSupported() {
+        if (!me.coderfrish.config.experiment.LegacyBukkitPluginConfig.foliaSupportedField)
+            return true;
+
         return this.foliaSupported;
     }
     // Folia end
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index dea28ea0e5812d5365ea50ff9f83721b3745cfda..60d98af4dfd57e7b698177cc4e18a091dba3bbd6 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -42,6 +42,8 @@ import java.util.logging.Level;
 import java.util.logging.Logger;
 import java.util.stream.Collectors;
 import javax.imageio.ImageIO;
+
+import me.coderfrish.scheduler.FixedCraftScheduler;
 import net.kyori.adventure.text.Component;
 import net.kyori.adventure.text.format.NamedTextColor;
 import net.minecraft.Optionull;
@@ -322,6 +324,8 @@ public final class CraftServer implements Server {
     private final io.papermc.paper.threadedregions.scheduler.FoliaAsyncScheduler asyncScheduler = new io.papermc.paper.threadedregions.scheduler.FoliaAsyncScheduler();
     private final io.papermc.paper.threadedregions.scheduler.FoliaGlobalRegionScheduler globalRegionScheduler = new io.papermc.paper.threadedregions.scheduler.FoliaGlobalRegionScheduler();
 
+    private final FixedCraftScheduler fixedCraftScheduler;
+
     @Override
     public final io.papermc.paper.threadedregions.scheduler.RegionScheduler getRegionScheduler() {
         return this.regionizedScheduler;
@@ -497,6 +501,7 @@ public final class CraftServer implements Server {
         this.potionBrewer = new io.papermc.paper.potion.PaperPotionBrewer(console); // Paper - custom potion mixes
         datapackManager = new io.papermc.paper.datapack.PaperDatapackManager(console.getPackRepository()); // Paper
         this.spark = new io.papermc.paper.SparksFly(this); // Paper - spark
+        this.fixedCraftScheduler = new FixedCraftScheduler(this.globalRegionScheduler, this.asyncScheduler);
     }
 
     public boolean getCommandBlockOverride(String command) {
@@ -951,7 +956,7 @@ public final class CraftServer implements Server {
 
     @Override
     public CraftScheduler getScheduler() {
-        return this.scheduler;
+        return (me.coderfrish.config.experiment.LegacyBukkitPluginConfig.scheduler ? fixedCraftScheduler : this.scheduler);
     }
 
     @Override
