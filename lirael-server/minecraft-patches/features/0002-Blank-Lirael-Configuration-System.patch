@@ -576,6 +576,12 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
             }
         }
 
+        try {
+            dev.coderfrish.lirael.config.LiraelConfig.save(); /* lirael config */
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+
         this.hasFullyShutdown = true; // Paper - Improved watchdog support
         System.exit(this.abnormalExit ? 70 : 0); // CraftBukkit // Paper - Improved watchdog support
