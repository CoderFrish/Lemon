Subject: [PATCH] Blank Lirael Configuration System.


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 01758ab2084c0b2d6a10d427ddf0e63753a64bdc..2ee330e1351c774dd19d027871783e5652aa8f0f 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -2061,7 +2061,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
     @DontObfuscate
     public String getServerModName() {
-        return io.papermc.paper.ServerBuildInfo.buildInfo().brandName(); // Paper
+        if (false) return io.papermc.paper.ServerBuildInfo.buildInfo().brandName(); // Paper
+        return dev.coderfrish.lirael.config.LiraelConfig.getServerModName();
     }
 
     public SystemReport fillSystemReport(SystemReport systemReport) {
diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index 3d8290b952e4341211ef8e669372bf7ea1c4bf62..f7ba92c86c0612adecea729a4177eeadafaf58da 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -272,7 +272,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
         thread.start(); // Paper - Enhance console tab completions for brigadier commands; start console thread after MinecraftServer.console & PaperConfig are initialized
         io.papermc.paper.command.PaperCommands.registerCommands(this); // Paper - setup /paper command
         this.server.spark.registerCommandBeforePlugins(this.server); // Paper - spark
-        com.destroystokyo.paper.Metrics.PaperMetrics.startMetrics(); // Paper - start metrics
+        if (false) com.destroystokyo.paper.Metrics.PaperMetrics.startMetrics(); // Paper - start metrics // Lirael - Stop metrics temporary.
         com.destroystokyo.paper.VersionHistoryManager.INSTANCE.getClass(); // Paper - load version history now
 
         // this.worldData.setGameType(properties.gameMode.get()); // CraftBukkit - moved to world loading
@@ -543,6 +543,12 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
             }
         }
 
+        try {
+            dev.coderfrish.lirael.config.LiraelConfig.save(); /* lirael config */
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+
         this.hasFullyShutdown = true; // Paper - Improved watchdog support
         System.exit(this.abnormalExit ? 70 : 0); // CraftBukkit // Paper - Improved watchdog support
     }
